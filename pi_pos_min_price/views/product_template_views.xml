<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_min_price" model="ir.ui.view">
        <field name="name">product.template.form.inherit.pi_pos_min_price</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='pos']//group[@name='pos']" position="inside">
                <field name="min_price"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       string="Precio Mínimo"/>
            </xpath>
        </field>
    </record>
</odoo>
