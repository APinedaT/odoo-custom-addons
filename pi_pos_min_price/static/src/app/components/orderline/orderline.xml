<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pi_pos_min_price.Orderline"
       t-inherit="point_of_sale.Orderline"
       t-inherit-mode="extension">
        <xpath expr="//span[hasclass('text-wrap')]" position="inside">
            <small t-if="this.minPriceTag &amp;&amp; !vals.isReceipt"
                   class="pi-min-price-tag text-muted d-block"
                   style="font-size: 0.72rem; line-height: 1.2;">
                <t t-esc="this.minPriceTag"/>
            </small>
        </xpath>
    </t>
</templates>
