<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <!-- Remove tax breakdown section -->
        <xpath expr="//div[hasclass('pos-receipt-taxes')]" position="replace"/>

        <!-- Remove company info block from the bottom -->
        <xpath expr="//div[hasclass('pos-config-name')]/../.." position="replace">
            <div class="pos-receipt-footer">
                <div class="pos-config-name d-flex justify-content-center pt-2">
                    Necesitas factura? 
                </div>
                <div class="pos-receipt-qr d-flex justify-content-center pt-2">
                    <img src="/pi_pos_custom_receipt/static/src/app/screens/receipt_screen/receipt/whatsapp_qr.png" alt="QR Code" width="100" height="100"/>
                </div>
            </div>
        </xpath>
    </t>
</templates>
