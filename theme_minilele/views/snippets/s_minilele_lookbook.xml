<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Mini Lele Lookbook
        ==================
        Instagram-style 6-tile grid + follow CTA.
    -->
    <template id="s_minilele_lookbook" name="Mini Lele · Lookbook Instagram">
        <section class="s_minilele_lookbook" data-snippet="s_minilele_lookbook" data-name="Mini Lele Lookbook">
            <div class="container">
                <div class="o_ml_section_head">
                    <span class="o_ml_eyebrow">@minilele.boutique</span>
                    <h2 class="mt-3">Síguenos en Instagram</h2>
                    <p>Inspírate con looks reales de nuestras pequeñas modelos. Etiquétanos para salir en nuestro feed.</p>
                </div>

                <div class="row g-2">
                    <div class="col-4 col-md-2"><div class="o_ml_look" style="background: linear-gradient(135deg, #FFE4F1, #FBD7E2);">👗</div></div>
                    <div class="col-4 col-md-2"><div class="o_ml_look" style="background: linear-gradient(135deg, #DFF1FB, #C8E7F8);">🦁</div></div>
                    <div class="col-4 col-md-2"><div class="o_ml_look" style="background: linear-gradient(135deg, #DCF4F2, #BFE7E4);">👶</div></div>
                    <div class="col-4 col-md-2"><div class="o_ml_look" style="background: linear-gradient(135deg, #FFF1C8, #F5D480);">👑</div></div>
                    <div class="col-4 col-md-2"><div class="o_ml_look" style="background: linear-gradient(135deg, #E9DCFB, #D7C2F2);">🦄</div></div>
                    <div class="col-4 col-md-2"><div class="o_ml_look" style="background: linear-gradient(135deg, #E0F4D8, #C8E8B8);">⚽</div></div>
                </div>

                <div class="o_ml_ig_cta">
                    <a href="https://instagram.com/minilele.boutique" target="_blank" rel="noopener">
                        <i class="fa fa-instagram"/> Síguenos @minilele.boutique
                    </a>
                </div>
            </div>
        </section>
    </template>
</odoo>
