<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="dynamic_filter_template_product_product_pineda"
              name="Pineda · Tarjeta de producto">
        <t t-foreach="records" t-as="data"
           data-number-of-elements="4"
           data-number-of-elements-sm="1">

            <t t-set="record" t-value="data['_record']"/>
            <t t-set="product" t-value="record"/>
            <t t-set="product_template_id"
               t-value="record.id if not record.is_product_variant else record.product_tmpl_id.id"/>
            <t t-set="product_id"
               t-value="record.id if record.is_product_variant else record.product_variant_id.id"/>

            <t t-set="p_categ" t-value="record.public_categ_ids[:1]"/>
            <t t-set="p_tracked"
               t-value="'is_storable' in record._fields and 'free_qty' in record._fields and record.is_storable"/>
            <t t-set="p_in_stock"
               t-value="p_tracked and (record.allow_out_of_stock_order or record.sudo().free_qty &gt; 0)"/>

            <div class="o_pineda_product w-100" role="article"
                 t-att-aria-label="product.display_name"
                 t-att-data-add2cart-rerender="data.get('_add2cart_rerender')">

                <a class="o_pineda_product_media" t-att-href="product.website_url"
                   t-att-title="product.display_name" contenteditable="false">
                    <span t-if="data.get('has_discounted_price')" class="o_pineda_product_flag">Oferta</span>
                    <span t-if="is_sample" class="o_pineda_product_flag">Ejemplo</span>
                    <span role="img" t-attf-alt="{{product.display_name}}"
                          class="o_pineda_product_img"
                          t-attf-style="background-image: url({{data['image_512']}});"/>
                </a>

                <div class="o_pineda_product_body">
                    <span t-if="p_categ" class="o_pineda_product_cat" t-out="p_categ.name"/>
                    <a class="o_pineda_product_name" t-att-href="product.website_url"
                       t-out="product.display_name"/>

                    <div class="o_pineda_product_price"
                         t-if="not data.get('prevent_zero_price_sale') and not data.get('is_sample')">
                        <span class="o_pineda_amount" t-out="data['price']"
                              t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                        <span class="o_pineda_unit" t-if="record.uom_name">/ <t t-out="record.uom_name"/></span>
                        <span t-if="data.get('has_discounted_price')" class="o_pineda_old"
                              t-out="data['list_price']"
                              t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                    </div>

                    <span t-if="p_tracked"
                          t-attf-class="o_pineda_stock #{not p_in_stock and 'o_pineda_out' or ''}"
                          t-out="p_in_stock and 'En existencia' or 'Agotado'"/>

                    <div class="o_pineda_product_action" t-if="product._website_show_quick_add()">
                        <button type="button" class="btn btn-primary o_wsale_product_btn_primary js_add_cart"
                                title="Agregar al carrito"
                                t-att-data-product-id="product_id"
                                t-att-data-product-selected="product.is_product_variant"
                                t-att-data-product-template-id="product_template_id"
                                t-att-data-product-type="product.type"
                                t-att-data-show-quantity="is_view_active('website_sale.product_quantity')">
                            <i class="fa fa-shopping-cart" role="presentation"/>
                            <span class="o_label">Agregar</span>
                        </button>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
