<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pi_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">pi.res.config.settings.form.pos.einvoice</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pos_invoice_journal_id']/.." position="after">
                <div class="row">
                    <label string="Electronic Invoices" for="pos_electronic_invoice_journal_id"
                           class="col-lg-3 o_light_label"/>
                    <field name="pos_electronic_invoice_journal_id"
                           domain="[('company_id', '=', company_id), ('type', '=', 'sale')]"
                           context="{'default_company_id': company_id, 'default_type': 'sale'}"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
